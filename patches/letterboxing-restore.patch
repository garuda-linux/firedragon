Observe the selected browser's parent on tab selection for letterboxing, to ensure resizing works after a session is restored with multiple tabs
---
diff --git a/toolkit/components/resistfingerprinting/RFPHelper.sys.mjs b/toolkit/components/resistfingerprinting/RFPHelper.sys.mjs
index d11f8a011f..021d51eff7 100644
--- a/toolkit/components/resistfingerprinting/RFPHelper.sys.mjs
+++ b/toolkit/components/resistfingerprinting/RFPHelper.sys.mjs
@@ -119,6 +119,12 @@ class _RFPHelper {
         resizeObserver.observe(browser.parentElement);
         break;
       }
+      case "TabSelect": {
+        let browser = aMessage.target.linkedBrowser;
+        let resizeObserver = this._resizeObservers.get(browser.documentGlobal);
+        resizeObserver.observe(browser.parentElement);
+        break;
+      }
       default:
         break;
     }
@@ -620,6 +626,7 @@ class _RFPHelper {
   _attachWindow(aWindow) {
     aWindow.gBrowser.addTabsProgressListener(this);
     aWindow.addEventListener("TabOpen", this);
+    aWindow.gBrowser.tabContainer.addEventListener("TabSelect", this);
     let resizeObserver = new aWindow.ResizeObserver(entries => {
       for (let { target } of entries) {
         this._roundOrResetContentSize(target.querySelector("browser"));
@@ -662,6 +669,7 @@ class _RFPHelper {
     }
     tabBrowser.removeTabsProgressListener(this);
     aWindow.removeEventListener("TabOpen", this);
+    tabBrowser.tabContainer.removeEventListener("TabSelect", this);
 
     // revert tabpanel's style to default
     tabBrowser.tabpanels?.classList.remove("letterboxing");
