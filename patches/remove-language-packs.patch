@@ -403,6 +403,16 @@ BrowserGlue.prototype = {
 
     // handle any UI migration
     this._migrateUI();
+    
+    const removeLangpacks = async () => {
+      for (const addon of await lazy.AddonManager.getAddonsByTypes(["locale"])) {
+        await addon.uninstall();
