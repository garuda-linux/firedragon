+static bool JITEnabledForSiteOrigin(nsIURI* aSiteOriginURI,
+                                    WindowGlobalParent* aParentWindow,
+                                    nsIPrincipal* aPrincipal) {
+  bool enabled = StaticPrefs::librewolf_jit_enabled_by_default();
+
+  if (!aSiteOriginURI || !aPrincipal || !aPrincipal->GetIsContentPrincipal()) {
+    return enabled;
+  }
+
+  nsCOMPtr<nsIURI> effectiveSiteOriginURI;
+  if (NS_FAILED(GetEffectiveSiteOriginURI(aSiteOriginURI, aParentWindow,
+                                          effectiveSiteOriginURI))) {
+    return enabled;
+  }
+
+  nsCOMPtr<nsIPrincipal> sitePrincipal = BasePrincipal::CreateContentPrincipal(
+      effectiveSiteOriginURI, aPrincipal->OriginAttributesRef());
+
+  if (!sitePrincipal) {
+    return enabled;
+  }
+
+  RefPtr<PermissionManager> permissionManager =
+      PermissionManager::GetInstance();
+
+  if (!permissionManager) {
+    return enabled;
+  }
+
+  uint32_t action = nsIPermissionManager::UNKNOWN_ACTION;
+  nsresult rv = permissionManager->TestExactPermissionFromPrincipal(
+      sitePrincipal, "jit"_ns, &action);
+
+  if (NS_FAILED(rv)) {
+    return enabled;
+  }
+
+  switch (action) {
+    case nsIPermissionManager::ALLOW_ACTION:
+      return true;
+
+    case nsIPermissionManager::DENY_ACTION:
+      return false;
+
+    case nsIPermissionManager::UNKNOWN_ACTION:
+    default:
+      return enabled;
+  }
+}
