{
  "name": "firedragon",
  "version": "13.12.1",
  "private": true,
  "license": "MPL-2.0",
  "repository": {
    "type": "git",
    "url": "https://gitlab.com/garuda-linux/firedragon/firedragon13.git"
  },
  "type": "module",
  "scripts": {
    "format": "prettier --experimental-cli -w .",
    "make": "tsx make.ts",
    "all:dev": "lerna run --stream dev",
    "all:build": "lerna run --stream build"
  },
  "devDependencies": {
    "git-cliff": "^2.14.2",
    "lerna": "^10.1.1",
    "oxfmt": "^0.79.0",
    "tsx": "^4.23.15",
    "zx": "^8.8.5"
  },
  "config": {
    "firefox": {
      "version": "160.0"
    },
    "librewolf": {
      "release": "1"
    }
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^12.21.0",
      "onFail": "download"
    },
    "runtime": {
      "name": "node",
      "version": "^26.13.1",
      "onFail": "download"
    }
  }
