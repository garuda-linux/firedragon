ac_add_options --with-app-basename=FireDragon
ac_add_options --with-app-name=firedragon
ac_add_options --enable-application=browser
[ -n "${FIREDRAGON_ARTIFACT_BUILD-}" ] || ac_add_options --with-l10n-base=$(pwd)/browser/firedragon/l10n

# Branding
ac_add_options --allow-addon-sideload
[ -n "${FIREDRAGON_ARTIFACT_BUILD-}" ] || ac_add_options --enable-unverified-updates
ac_add_options --enable-update-channel=release
ac_add_options --with-distribution-id=org.garudalinux
ac_add_options --with-unsigned-addon-scopes=app,system
export MOZ_APP_REMOTINGNAME=firedragon
export MOZ_REQUIRE_SIGNING=
mk_add_options MOZ_CRASHREPORTER=0
mk_add_options MOZ_DATA_REPORTING=0
mk_add_options MOZ_SERVICES_HEALTHREPORT=0
mk_add_options MOZ_TELEMETRY_REPORTING=0

# Features
ac_add_options --disable-crashreporter
ac_add_options --disable-default-browser-agent
[ -n "${FIREDRAGON_ARTIFACT_BUILD-}" ] || ac_add_options --disable-debug
ac_add_options --disable-tests
[ -n "${FIREDRAGON_ARTIFACT_BUILD-}" ] || ac_add_options --enable-jemalloc

# Build options
mk_add_options MOZ_OBJDIR="$PWD/obj"
[ -n "${FIREDRAGON_ARTIFACT_BUILD-}" ] || ac_add_options --disable-cargo-incremental
[ -n "${FIREDRAGON_ARTIFACT_BUILD-}" ] || ac_add_options --enable-hardening
[ -n "${FIREDRAGON_ARTIFACT_BUILD-}" ] || ac_add_options --enable-stl-hardening
ac_add_options --enable-release
ac_add_options --enable-rust-simd
[ -n "${FIREDRAGON_ARTIFACT_BUILD-}" ] || ac_add_options --enable-optimize
