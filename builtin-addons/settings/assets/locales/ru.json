{
  "title": "Настройки FireDragon",
  "back": "Назад к настройкам",
  "pages": {
    "home": {
      "title": "Настройки FireDragon",
      "description": "Мы тщательно подбираем настройки по умолчанию, уделяя особое внимание приватности и безопасности. Прежде чем менять настройки, прочитайте описание, чтобы понимать последствия изменений.",
      "browserBehaviour": {
        "title": "Поведение браузера",
        "autoUpdateExtensions": {
          "title": "Автоматически обновлять дополнения",
          "description": "Обновлять расширения без ручного вмешательства. Хороший выбор для безопасности. Если вы не проверяете код расширений перед каждым обновлением, эту опцию стоит включить."
        },
        "enableSync": {
          "title": "Включить FireDragon Sync",
          "description": "Синхронизировать данные с другими браузерами. Требуется перезапуск. FireDragon Sync шифрует данные локально перед отправкой на сервер.",
          "restartDialog": {
            "title": "Требуется перезапуск",
            "message": "Чтобы полностью включить или отключить FireDragon Sync, требуется перезапуск FireDragon."
          }
        },
        "enableMiddleClickPaste": {
          "title": "Включить вставку средней кнопкой мыши",
          "description": "Выделите текст, чтобы скопировать его, затем вставьте щелчком средней кнопки мыши."
        },
        "hidePasswdmgr": {
          "title": "Скрыть менеджер паролей",
          "description": "Скрыть пункт меню и настройки менеджера паролей.",
          "restartDialog": {
            "title": "Требуется перезапуск",
            "message": "Чтобы полностью показать или скрыть менеджер паролей, требуется перезапуск FireDragon."
          }
        },
        "enableTranslations": {
          "title": "Включить переводы",
          "description": "Включить офлайн-перевод."
        },
        "closeWindowWithLastTab": {
          "title": "Закрывать окно вместе с последней вкладкой",
          "description": "Закрывать окно браузера при закрытии последней вкладки."
        }
      },
      "networking": {
        "title": "Сеть",
        "enableIPv6": {
          "title": "Включить IPv6",
          "description": "Разрешить FireDragon подключаться по IPv6. Вместо блокировки IPv6 в браузере рекомендуем включить расширение приватности IPv6 в вашей ОС."
        }
      },
      "privacy": {
        "title": "Приватность",
        "enablePrefetchConfig": {
          "title": "Включить предзагрузку",
          "description": "Предзагрузка — функция браузера, позволяющая скачивать ресурсы в фоне, пока пользователь просматривает страницы. Это может повысить производительность и снизить расход трафика.",
          "restartDialog": {
            "title": "Требуется перезапуск",
            "message": "Чтобы полностью включить или отключить предзагрузку, требуется перезапуск FireDragon."
          }
        },
        "limitCrossOriginReferrers": {
          "title": "Ограничить передачу рефереров между источниками",
          "description": "Передавать реферер только для запросов с того же источника. Это может сломать работу некоторых сайтов. Кроме того, даже передаваемые рефереры будут усечены."
        },
        "autoRefuseCookies": {
          "title": "Автоматически отклонять баннеры cookie",
          "description": "Когда сайт спрашивает разрешение на использование cookie, FireDragon автоматически отказывает за вас. Только на поддерживаемых сайтах. Не совместимо с блокировкой всех cookie / строгим режимом."
        }
      },
      "fingerprinting": {
        "title": "Снятие отпечатков",
        "enableRFP": {
          "title": "Включить ResistFingerprinting",
          "description": "ResistFingerprinting — лучший инструмент защиты от снятия отпечатков. Если нужно его отключить, подумайте о расширении вроде Canvas Blocker."
        },
        "enableLetterboxing": {
          "title": "Включить letterboxing",
          "description": "Letterboxing добавляет поля вокруг окна, чтобы сообщать ограниченный набор округлённых разрешений."
        },
        "enableWebGL": {
          "title": "Включить WebGL",
          "description": "WebGL — сильный вектор для снятия отпечатков. Если нужно его включить, подумайте о расширении вроде Canvas Blocker."
        },
        "enableWebGLPrompt": {
          "title": "Включить обработку разрешений WebGL",
          "description": "Включает обработку разрешений для WebGL: на сайтах, которым он нужен, будет запрошено разрешение. Если отключено, WebGL доступен всем сайтам."
        },
        "hideWebGLPrompt": {
          "title": "Скрыть запрос разрешения WebGL",
          "description": "Скрывает запрос разрешения WebGL. Он останется доступен из адресной строки."
        }
      },
      "security": {
        "title": "Безопасность",
        "enforceOCSP": {
          "title": "Включить жёсткий отказ OCSP",
          "description": "Запрещать подключение к сайту, если проверку OCSP выполнить не удалось. Это повышает безопасность, но ломает работу при недоступности OCSP-сервера."
        },
        "enable0rtt": {
          "title": "Включить TLS 1.3 0-RTT",
          "description": "Включает 0-RTT (Zero Round Trip Time) для TLS-соединений. Это может повысить производительность, но увеличивает риски безопасности."
        },
        "enableSafeBrowsing": {
          "title": "Включить Google Safe Browsing",
          "description": "Если вы опасаетесь вредоносного ПО и фишинга, стоит включить. Отключено из-за опасений цензуры, но рекомендуется менее опытным пользователям. Все проверки выполняются локально."
        },
        "scanDownloads": {
          "title": "Сканировать загрузки",
          "description": "Разрешить Safe Browsing проверять загрузки на подозрительные файлы. Все проверки выполняются локально."
        }
      }
    },
