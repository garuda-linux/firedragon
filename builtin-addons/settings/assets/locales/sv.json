{
  "title": "FireDragon Inställningar",
  "back": "Tillbaka till inställningar",
  "pages": {
    "home": {
      "title": "FireDragon Inställningar",
      "description": "Vi väljer noggrant standardinställningar för att fokusera på integritet och säkerhet. När du ändrar dessa inställningar, läs beskrivningen för att förstå konsekvenserna av dessa förändringar.",
      "browserBehaviour": {
        "title": "Webbläsarbeteende",
        "autoUpdateExtensions": {
          "title": "Uppdatera tillägg automatiskt",
          "description": "Håll Extensions uppdaterade utan manuellt ingrepp. Ett bra val för din säkerhet. Om du inte granskar koden för dina tillägg innan varje uppdatering, bör du aktivera det här alternativet."
        },
        "enableSync": {
          "title": "Aktivera FireDragon Sync",
          "description": "Synkronisera dina data med andra webbläsare. Kräver omstart. FireDragon Sync krypterar data lokalt innan du överför den till servern.",
          "restartDialog": {
            "title": "Omstart krävs",
            "message": "FireDragons omstart krävs för att helt aktivera eller inaktivera FireDragon Sync."
          }
        },
        "enableMiddleClickPaste": {
          "title": "Aktivera klistra in med mellanklick",
          "description": "Välj text för att kopiera, klistra sedan in den med ett mellanmusklick."
        },
        "hidePasswdmgr": {
          "title": "Dölj lösenordshanterare",
          "description": "Dölj lösenordshanterarens meny objekt och inställningar.",
          "restartDialog": {
            "title": "Omstart krävs",
            "message": "FireDragons omstart krävs för att helt visa eller dölja lösenordshanteraren."
          }
        },
        "enableTranslations": {
          "title": "Aktivera översättningar",
          "description": "Aktivera offline översättningar."
        },
        "closeWindowWithLastTab": {
          "title": "Stäng fönster med sista fliken",
          "description": "Stäng webbläsarfönstret när den sista fliken är stängd."
        }
      },
      "networking": {
        "title": "Nätverk",
        "enableIPv6": {
          "title": "Aktivera IPv6",
          "description": "Låt FireDragon ansluta med IPv6. Istället för att blockera IPv6 i webbläsaren, föreslår vi aktivering av IPv6-sekretesstillägg i ditt operativsystem."
        }
      },
      "privacy": {
        "title": "Sekretess",
        "enablePrefetchConfig": {
          "title": "Aktivera prefetching",
          "description": "Prefetching är en webbläsare funktion som låter webbläsaren ladda ner resurser i bakgrunden medan användaren surfar. Detta kan förbättra prestanda och minska bandbreddsanvändningen.",
          "restartDialog": {
            "title": "Omstart krävs",
            "message": "FireDragons omstart krävs för att helt aktivera eller inaktivera prefetching."
          }
        },
        "limitCrossOriginReferrers": {
          "title": "Begränsa korsursprungreferenser",
          "description": "Skicka hänvisare endast på samma ursprung. Detta kan orsaka avbrott. Dessutom kommer även, när skickade, hänvisare fortfarande att trimmas."
        },
        "autoRefuseCookies": {
          "title": "Automatiskt vägra cookiebanners",
          "description": "När en webbplats frågar om de kan använda cookies vägrar FireDragon automatiskt för dig. Endast på stödda webbplatser. Inte kompatibelt med att blockera alla cookies/Strikt-läge."
        }
      },
      "fingerprinting": {
        "title": "Fingerprinting",
        "enableRFP": {
          "title": "Aktivera ResistFingerprinting",
          "description": "ResistFingerprinting är ett bäst i klassen anti-fingerprintingverktyg. Om du behöver inaktivera det, överväga att använda en extension som Canvas Blocker."
        },
        "enableLetterboxing": {
          "title": "Aktivera letterboxing",
          "description": "Letterboxing tillämpar marginaler runt dina fönster, för att returnera en begränsad uppsättning av rundade upplösningar."
        },
        "enableWebGL": {
          "title": "Aktivera WebGL",
          "description": "WebGL är en stark fingerprintingvektor. Om du behöver aktivera det, överväga att använda en förlängning som Canvas Blocker."
        },
        "enableWebGLPrompt": {
          "title": "Aktivera WebGL tillståndshantering",
          "description": "Detta kommer att möjliggöra tillståndshantering för WebGL så att du kan tillåta WebGL på webbplatser som kräver det. När avaktiverat kommer WebGL att vara tillgänglig för alla webbplatser."
        },
        "hideWebGLPrompt": {
          "title": "Dölj WebGL tillståndsförfrågan",
          "description": "Gömmer tillståndsförfrågan för WebGL. Det kommer fortfarande att vara tillgängligt från URL-fältet."
        }
      },
      "security": {
        "title": "Säkerhet",
        "enforceOCSP": {
          "title": "Tvinga OCSP hard-fail",
          "description": "Förhindra anslutning till en webbplats om OCSP-kontrollen inte kan utföras. Detta ökar säkerheten, men det kommer att orsaka avbrott när en OCSP-server är nere."
        },
        "enable0rtt": {
          "title": "Aktivera TLS 1.3 0-RTT",
          "description": "Aktivera 0-RTT (Zero Round Trip Time) för TLS-anslutningar. Detta kan förbättra prestanda men kan öka säkerhetsrisker."
        },
        "enableSafeBrowsing": {
          "title": "Aktivera Google Säker Surf",
          "description": "Om du är orolig för skadlig kod och phishing, överväg att aktivera det. Inaktiverad för censurproblem men rekommenderas för mindre avancerade användare. Alla kontroller sker lokalt."
        },
        "scanDownloads": {
          "title": "Sök igenom nedladdningar",
          "description": "Tillåt Säker Surf att skanna dina nedladdningar för att identifiera misstänkta filer. Alla kontroller sker lokalt."
        }
      }
    },
