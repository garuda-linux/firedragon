#filter substitution
{
  "__COMMENT__ More Information": "https://github.com/mozilla/policy-templates/blob/master/README.md",
  "policies": {
#ifndef FIREDRAGON_UPDATE
    "AppUpdateURL": "https://localhost",
    "DisableAppUpdate": true,
#endif
    "OverridePostUpdatePage": "",
    "DisableSystemAddonUpdate": true,
    "DisableProfileImport": false,
    "DisableFirefoxStudies": true,
    "DisableTelemetry": true,
    "DisableFeedbackCommands": true,
    "DisablePocket": true,
    "DisableSetDesktopBackground": false,
    "DisableDeveloperTools": false,
    "NoDefaultBookmarks": true,
    "WebsiteFilter": {
      "Block": [
        "https://localhost/*"
      ],
      "Exceptions": [
        "https://localhost/*"
      ]
    },
    "ExtensionSettings": {
      "*": {
        "blocked_install_message": "FireDragon does not allow installing Language Packs.",
        "installation_mode": "allowed",
        "allowed_types": ["dictionary", "extension", "sitepermission", "theme"]
      },
      "uBlock0@raymondhill.net": {
        "install_url": "https://addons.mozilla.org/firefox/downloads/latest/uBlock0@raymondhill.net/latest.xpi",
        "installation_mode": "normal_installed",
        "private_browsing": true
      },
      "{1018e4d6-728f-4b20-ad56-37578a4de76b}": {
        "install_url": "https://addons.mozilla.org/firefox/downloads/latest/flagfox/latest.xpi",
        "installation_mode": "normal_installed"
      },
#if FIREDRAGON_THEME == sweetDark
      "{59f619c8-220b-4a27-8918-bf1537bc060a}": {
        "install_url": "https://addons.mozilla.org/firefox/downloads/latest/sweet-dark/latest.xpi",
        "installation_mode": "normal_installed"
      },
#elif FIREDRAGON_THEME == catppuccinMochaMauve
      "{d090b7ee-a385-4d54-b9a4-f7164d17756d}": {
        "install_url": "https://addons.mozilla.org/firefox/downloads/latest/catppuccin-mocha-mauve/latest.xpi",
        "installation_mode": "normal_installed"
      },
#endif
      "google@search.mozilla.org": {
        "installation_mode": "blocked"
      },
      "bing@search.mozilla.org": {
        "installation_mode": "blocked"
      },
      "amazondotcom@search.mozilla.org": {
        "installation_mode": "blocked"
      },
      "ebay@search.mozilla.org": {
        "installation_mode": "blocked"
      },
      "twitter@search.mozilla.org": {
        "installation_mode": "blocked"
      }
    },
    "SearchEngines": {
      "PreventInstalls": false,
      "Remove": [
        "Amazon.com",
        "eBay",
        "Twitter",
        "Perplexity"
      ],
      "Default": "DuckDuckGo",
      "Add": [
        {
          "Name": "Brave",
          "Description": "Brave Search: private, independent, open",
          "Alias": "@brave",
          "Method": "GET",
          "URLTemplate": "https://search.brave.com/search?q={searchTerms}",
          "SuggestURLTemplate": "https://search.brave.com/api/suggest?q={searchTerms}",
          "IconURL": "data:image/png;base64,"
        },
        {
          "Name": "DuckDuckGo NoAI",
          "Description": "Minimal, ad-free version of DuckDuckGo",
          "Alias": "@ddg-noai",
          "Method": "POST",
          "URLTemplate": "https://noai.duckduckgo.com/?q={searchTerms}",
          "PostData": "q={searchTerms}",
          "SuggestURLTemplate": "https://ac.duckduckgo.com/ac/?q={searchTerms}&type=list",
          "IconURL": "data:image/x-icon;base64,"
        },
        {
          "Name": "DuckDuckGo Lite",
          "Description": "Minimal, ad-free version of DuckDuckGo",
          "Alias": "@ddg-lite",
          "Method": "POST",
          "URLTemplate": "https://start.duckduckgo.com/lite/?q={searchTerms}",
          "PostData": "q={searchTerms}",
          "SuggestURLTemplate": "https://ac.duckduckgo.com/ac/?q={searchTerms}&type=list",
          "IconURL": "data:image/x-icon;base64,"
        },
        {
          "Name": "Garuda's searX",
          "Description": "A privacy-respecting, hackable metasearch engine",
          "Alias": "@sx",
          "Method": "POST",
          "URLTemplate": "https://searx.garudalinux.org/?q={searchTerms}",
          "PostData": "q={searchTerms}",
          "IconURL": "data:image/x-icon;base64,"
        },
        {
          "Name": "Garuda's Whoogle",
          "Description": "Minimal, ad-free version of Google search",
          "Alias": "@wg",
          "Method": "GET",
          "URLTemplate": "https://search.garudalinux.org/search?q={searchTerms}",
          "PostData": "q={searchTerms}",
          "IconURL": "data:image/x-icon;base64,"
        },
        {
          "Name": "Kagi",
          "Description": "A privacy-focused, user-centric search engine.",
          "Alias": "@kagi",
          "Method": "GET",
          "URLTemplate": "https://kagi.com/search?q={searchTerms}",
          "SuggestURLTemplate": "https://kagisuggest.com/api/autosuggest?q={searchTerms}",
          "IconURL": "data:image/png;base64,"
        },
        {
          "Name": "MetaGer",
          "Description": "Search safely while having your privacy respected",
          "Alias": "@mg",
          "Method": "GET",
          "URLTemplate": "https://metager.org/meta/meta.ger3?eingabe={searchTerms}",
          "SuggestURLTemplate": "https://metager.org/suggest?query={searchTerms}",
          "IconURL": "data:image/x-icon;base64,"
        },
        {
          "Name": "Mojeek",
          "Description": "A web search engine that provides unbiased, fast, and relevant search results combined with a no tracking privacy policy",
          "Alias": "@mj",
          "Method": "GET",
          "URLTemplate": "https://www.mojeek.com/search?q={searchTerms}",
          "IconURL": "data:image/x-icon;base64,"
        },
        {
          "Name": "Qwant",
          "Description": "Qwant - The search engine that doesn't know anything about you.",
          "Alias": "@qwant",
          "Method": "GET",
          "URLTemplate": "https://www.qwant.com?q={searchTerms}&client=opensearch",
          "SuggestURLTemplate": "https://api.qwant.com/v3/suggest/?q={searchTerms}&client=opensearch",
          "IconURL": "data:image/png;base64,"
        },
        {
          "Name": "Searx (local - needs 'searx' installed)",
          "Description": "A privacy-respecting, hackable metasearch engine",
          "Alias": "@sxl",
          "Method": "POST",
          "URLTemplate": "http://localhost:8888/?q={searchTerms}",
          "PostData": "q={searchTerms}",
          "IconURL": "data:image/x-icon;base64,"
        },
        {
          "Name": "Searx Belgium",
          "Description": "A privacy-respecting, open metasearch engine",
          "Alias": "@sxb",
          "Method": "POST",
          "URLTemplate": "https://searx.be/?q={searchTerms}",
          "PostData": "q={searchTerms}&category_general=on",
          "SuggestURLTemplate": "https://searx.be/autocompleter?q={searchTerms}",
          "IconURL": "data:image/x-icon;base64,"
        },
        {
          "Name": "Startpage",
          "Description": "Search and browse the internet without being tracked or targeted",
          "Alias": "@sp",
          "Method": "GET",
          "URLTemplate": "https://www.startpage.com/sp/search?query={searchTerms}&cat=web&pl=opensearch",
          "SuggestURLTemplate": "https://www.startpage.com/osuggestions?q={searchTerms}",
          "IconURL": "data:image/x-icon;base64,"
        },
        {
          "Name": "Whoogle (local - needs 'whoogle' installed)",
          "Description": "Minimal, ad-free version of Google search",
          "Alias": "@wgl",
          "Method": "GET",
          "URLTemplate": "http://localhost:5000/search?q={searchTerms}",
          "PostData": "q={searchTerms}",
          "IconURL": "data:image/x-icon;base64,"
        }
      ]
    },
    "SkipTermsOfUse": true,
    "SupportMenu": {
      "Title": "FireDragon support",
      "URL": "https://forum.garudalinux.org/c/issues-assistance/firedragon-browser-support/47"
    }
  }
}
